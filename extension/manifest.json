{
  "manifest_version": 3,
  "name": "YouTube Shorts & Lag Fix",
  "version": "0.1.4",
  "description": "Fixes YouTube Shorts showing the wrong video, and stops long YouTube sessions lagging by reloading the page every N videos to free memory.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["shorts-fix.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["refresh-core.js", "playback-core.js", "refresh.js"]
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["playback-core.js", "playback.js"],
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "YouTube Shorts & Lag Fix settings",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shorts-wrong-video-fix@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
